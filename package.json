{
  "name": "neonwire",
  "version": "0.1.0",
  "description": "Live feed / thread monitor with a neon cyberpunk UI",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c magenta,cyan \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
